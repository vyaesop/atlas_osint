# ---- Application ----
PROJECT_NAME=Project Atlas
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
# Async URL is derived from the above by config.py; override only if needed.
# For a managed/cloud Postgres, set DATABASE_URL (asyncpg driver) instead — it
# takes precedence over the discrete vars above:
# DATABASE_URL=postgresql+asyncpg://user:pass@your-host:5432/atlas?ssl=require

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atlas_neo4j_pw
NEO4J_DATABASE=neo4j

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Scaling (Phase 6) ----
# Cache analytics/dashboard reads in Redis (default off → in-process, no Redis).
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
# Offload graph-sync / search-index / ingestion to the arq worker (needs Redis
# + a running `arq app.jobs.worker.WorkerSettings`). Default off → synchronous.
JOBS_ENABLED=false
BULK_IMPORT_MAX_ITEMS=50000

# ---- Search ----
# "inmemory" for a zero-dependency dev backend, "opensearch" for production.
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=atlas-entities
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=256
SEMANTIC_SEARCH_ENABLED=true

# ---- Analytics ----
# "networkx" computes locally over Postgres; "neo4j_gds" is the future scale path.
ANALYTICS_BACKEND=networkx
ANALYTICS_MAX_NODES=5000

# ---- AI extraction (Phase 4) ----
# "gemini" (default) uses Google Gemini (free tier) — set GEMINI_API_KEY below.
#          With no key it transparently degrades to the offline heuristic, so
#          the app still runs end-to-end; AI quality is just lower.
# "anthropic" uses Claude — set ANTHROPIC_API_KEY.
# "heuristic" runs fully offline with no API key (deterministic, private).
AI_PROVIDER=gemini
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_INPUT_CHARS=100000

# Gemini (Google AI Studio key, usually starts with AIza...)
# GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Anthropic / Claude
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-4-8

# ---- Initial admin (used by seed script) ----
FIRST_ADMIN_EMAIL=admin@atlas.example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
